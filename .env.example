# 默认不调用联网模型；新阅读器保留原始材料待整理，不用规则冒充 AI 理解。
LLM_MODE=baseline
# 可选：设为 compatible 后填写你自己的兼容 Chat Completions 接口。
# LLM_MODE=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4500
# provider_default 不发送额外参数；DeepSeek 可显式设 enabled / disabled。
LLM_THINKING=provider_default
# 阅读器数据保存在项目 .local/briefing-v2.db；环境与数据库不提交 Git。

# 扩展来源默认使用匿名公开接口；如有需要，仅在本项目配置自己的密钥。
# AnySearch 网页搜索；不填写则匿名访问，受提供方限额约束。
# READER_WEB_API_KEY=
# OpenAlex 研究索引；不填写则使用公开基础接口。
# READER_OPENALEX_API_KEY=
# X 官方近期帖子检索，仅填写你为本项目授权的应用 Bearer Token；不配置时只检索公开网页线索。
# READER_X_BEARER_TOKEN=
# 每日模型调用次数与 Token 总量默认均不设上限；继续记录实际用量。需要时可自行设置，例如：
# READER_REQUESTS_PER_DAY=500
# READER_TOKENS_PER_DAY=2000000
# 每日用量在此时区的零点重新统计；留空使用系统时区。
# READER_TIMEZONE=Asia/Shanghai
# 每次模型请求整理的材料数（1–6）、话题追踪每轮最多整理的材料数（1–24）、同时进行的模型请求数（1–4）。
# READER_BATCH_SIZE=4
# READER_FOLLOW_ANALYZE_LIMIT=6
# READER_MODEL_CONCURRENCY=1

# 公开日报：设置后，每次更新完成都会把不含个人数据的日报（静态网页 + RSS）写到这个目录。
# 可指向一个开启了 GitHub Pages 的独立仓库目录；相对路径以本项目为根。留空则只能用命令手动生成。
# READER_PUBLISH_DIR=.local/public
# 日报对外的访问地址，RSS 链接需要它，例如：
# READER_PUBLIC_URL=https://your-name.github.io/northing-daily/

# 账号：token（默认）每位读者用令牌登录，每个令牌是一个独立账号；off 为本机单人使用，不需要登录。
# 本机自用可设为 off；部署到云端请保持 token，并用 HTTPS 反向代理。
# READER_AUTH=token
# 是否允许访客在登录页一键创建令牌；每个来源地址每小时最多创建次数。
# READER_SIGNUP=true
# READER_SIGNUPS_PER_HOUR=10
# 普通账号的限额（管理员不受限）：最多追踪话题数；每天主动检索、AI 理解需求与手动检查追踪的合计次数（留空不限）。
# READER_USER_FOLLOW_LIMIT=3
# READER_USER_REQUESTS_PER_DAY=10
# 登录 Cookie 的 Secure 标记：auto 跟随请求是否为 HTTPS（含 X-Forwarded-Proto）。
# READER_COOKIE_SECURE=auto
# 除本站外允许提交操作的来源，逗号分隔（一般不需要）。
# READER_ALLOWED_ORIGINS=
# 可选：使用 Cloudflare 命名隧道（固定域名）时的 Tunnel Token，仅用于 scripts/cloudflare.ps1 或 compose.cloudflare.yaml。
# CLOUDFLARE_TUNNEL_TOKEN=
