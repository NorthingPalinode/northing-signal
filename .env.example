# 默认不调用联网模型；新阅读器保留原始材料待整理，不用规则冒充 AI 理解。
LLM_MODE=baseline
# 可选：设为 compatible 后填写你自己的兼容 Chat Completions 接口。
# LLM_MODE=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4500
# provider_default 不发送额外参数；DeepSeek 可显式设 enabled / disabled。
LLM_THINKING=provider_default
# 以下为旧运行入口的兼容配置；默认阅读器不使用这些开关或 DATABASE_URL。
MAX_CONCURRENT_CHECKS=2
DEMO_SEED=false
NEWS_AUTO_REFRESH=true
NEWS_MEDIA_FETCH=true
NEWS_READING_FETCH=true
# false 关闭后台新闻获取，仍可手动刷新；新闻刷新不触发模型检查。
# 默认数据库在项目 .local/cfaw-news.db；环境与数据库不提交 Git。
# DATABASE_URL=sqlite:///D:/agent_project/cfaw-news/.local/cfaw-news.db

# 扩展来源默认使用匿名公开接口；如有需要，仅在本项目配置自己的密钥。
# AnySearch 网页搜索；不填写则匿名访问，受提供方限额约束。
# READER_WEB_API_KEY=
# OpenAlex 研究索引；不填写则使用公开基础接口。
# READER_OPENALEX_API_KEY=
# X 官方近期帖子检索，仅填写你为本项目授权的应用 Bearer Token；不配置时只检索公开网页线索。
# READER_X_BEARER_TOKEN=
# 每日模型调用次数与 Token 总量默认均不设上限；继续记录实际用量。
