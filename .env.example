# 默认不调用联网模型；新阅读器保留原始材料待整理，不用规则冒充 AI 理解。
LLM_MODE=baseline
# 可选：设为 compatible 后填写你自己的兼容 Chat Completions 接口。
# LLM_MODE=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=4500
# provider_default 不发送额外参数；DeepSeek 可显式设 enabled / disabled。
LLM_THINKING=provider_default
# 阅读器数据保存在项目 .local/briefing-v2.db；环境与数据库不提交 Git。

# 扩展来源默认使用匿名公开接口；如有需要，仅在本项目配置自己的密钥。
# AnySearch 网页搜索；不填写则匿名访问，受提供方限额约束。
# READER_WEB_API_KEY=
# OpenAlex 研究索引；不填写则使用公开基础接口。
# READER_OPENALEX_API_KEY=
# X 官方近期帖子检索，仅填写你为本项目授权的应用 Bearer Token；不配置时只检索公开网页线索。
# READER_X_BEARER_TOKEN=
# 每日模型调用次数与 Token 总量默认均不设上限；继续记录实际用量。需要时可自行设置，例如：
# READER_REQUESTS_PER_DAY=500
# READER_TOKENS_PER_DAY=2000000
# 每日用量在此时区的零点重新统计；留空使用系统时区。
# READER_TIMEZONE=Asia/Shanghai
# 每次模型请求整理的材料数（1–6）、话题追踪每轮最多整理的材料数（1–24）、同时进行的模型请求数（1–4）。
# READER_BATCH_SIZE=4
# READER_FOLLOW_ANALYZE_LIMIT=6
# READER_MODEL_CONCURRENCY=1
